<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Il file delle carte è criptato con chiave legata al Keystore del dispositivo:
         escluso dal backup cloud e dal trasferimento device-to-device (inutile copiarlo,
         non sarebbe leggibile su un altro telefono). Per spostare le carte su un nuovo
         dispositivo usa "Backup e ripristino" → export con password. -->
    <cloud-backup>
        <exclude domain="file" path="fidelybar_cards.json"/>
        <exclude domain="file" path="fidelybar_cards.json.bak"/>
        <exclude domain="file" path="fidelybar_cards.json.tmp"/>
        <exclude domain="file" path="logos/"/>
        <exclude domain="sharedpref" path="fidelybar_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="fidelybar_cards.json"/>
        <exclude domain="file" path="fidelybar_cards.json.bak"/>
        <exclude domain="file" path="fidelybar_cards.json.tmp"/>
    </device-transfer>
</data-extraction-rules>